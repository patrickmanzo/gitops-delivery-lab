# openbao/openbao-admin SA token generated by make (TF_VAR_openbao_jwt)
provider "vault" {
  address          = "http://127.0.0.1:8200"
  skip_child_token = true
  auth_login {
    path = "auth/kubernetes/login"
    parameters = {
      role = "admin"
      jwt  = var.openbao_jwt
    }
  }
}

# the provider rejects "*.localhost.*" hosts: Makefile port-forward
provider "gitea" {
  base_url = "http://127.0.0.1:3000"
  username = "gitea_admin"
  password = local.admin_password
}

provider "harbor" {
  url      = "http://harbor.localhost.com"
  username = "admin"
  password = local.admin_password
}

provider "sonarqube" {
  host = "http://sonarqube.localhost.com"
  user = "admin"
  pass = local.admin_password
}

provider "kubernetes" {
  config_path    = "~/.kube/config"
  config_context = "kind-cicd"
}
